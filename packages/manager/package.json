    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
